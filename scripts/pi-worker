#!/bin/sh
set -eu

if [ "$#" -ne 2 ] || [ ! -s "$1" ] || [ -z "$2" ]; then
    echo 'Usage from project root: scripts/pi-worker SPEC_FILE "milestone and allowed paths"' >&2
    exit 2
fi
case ${DEEPSEEK_API_KEY:-} in
    ''|XXXX) echo 'Set DEEPSEEK_API_KEY in the terminal before starting Claude.' >&2; exit 2 ;;
esac

PATH="$HOME/.local/share/dual-agent/node_modules/.bin:$PATH"
export PATH
command -v pi >/dev/null || { echo 'Install Pi using the setup in README.md.' >&2; exit 1; }

exec pi --print --no-session --no-extensions --no-skills --no-prompt-templates \
    --provider deepseek --model "${DEEPSEEK_MODEL:-deepseek-v4-flash}" \
    --tools read,ls,find,grep,edit,write \
    --append-system-prompt 'You implement one assignment for a supervising engineer. Work only inside the project and within the assigned scope. Preserve existing edits. Leave Git, running commands, tests, and publication to the manager. Report files changed, acceptance criteria addressed, and outstanding issues.' \
    "@$1" "Assignment: $2" </dev/null
